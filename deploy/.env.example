RUSTDESK_ID_SERVER=rd.example.com:21116
RUSTDESK_RELAY_SERVER=rd.example.com:21117
RUSTDESK_API_URL=https://remote.example.com
# This is id_ed25519.pub, never the private id_ed25519 file.
RUSTDESK_PUBLIC_KEY=replace-with-your-existing-public-key
# Leave empty until the exact reverse proxy address seen by the container is known.
TRUSTED_PROXY_IPS=

# QQ 个人邮箱：先开启 SMTP，密码填 SMTP 授权码；不是 QQ 登录密码。
# 配好所有字段后将 MAIL_ENABLED 改成 true，再重建容器。
MAIL_ENABLED=false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME="RustDesk 账号中心"
MAIL_TLS=implicit
MAIL_SEND_INTERVAL_SECONDS=5
MAIL_DAILY_LIMIT=100
