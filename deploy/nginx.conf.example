# Put these zones in nginx's http context (e.g. a conf.d file).
limit_req_zone $binary_remote_addr zone=rd_register:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=rd_login:10m rate=10r/m;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name remote.example.com;
    ssl_certificate /etc/letsencrypt/live/remote.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/remote.example.com/privkey.pem;
    client_max_body_size 2m;
    limit_req_status 429;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Overwrite client-supplied forwarding headers at this public ingress.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;

    location = /api/admin/user/register {
        limit_req zone=rd_register burst=3 nodelay;
        proxy_pass http://127.0.0.1:21114;
    }
    location ~ ^/api/(admin/)?login$ {
        limit_req zone=rd_login burst=10 nodelay;
        proxy_pass http://127.0.0.1:21114;
    }
    # These upstream endpoints accept unauthenticated telemetry. They are outside v1.
    location ~ ^/api/(audit/|sysinfo|heartbeat) { return 404; }
    location / { proxy_pass http://127.0.0.1:21114; }
}
