# syntax=docker/dockerfile:1
# Supply the sibling frontend with --build-context frontend=../rustdesk-api-web.
FROM node:22-bookworm-slim AS web
WORKDIR /src
COPY --from=frontend package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --from=frontend . .
RUN npm run build

FROM golang:1.24-bookworm AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/apimain ./cmd/apimain.go

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home app
WORKDIR /app
COPY --from=backend /out/apimain ./apimain
COPY conf ./conf
COPY resources ./resources
COPY --from=web /src/dist ./resources/admin
RUN mkdir -p /app/data /app/runtime/cache && chown -R app:app /app
USER app
VOLUME ["/app/data", "/app/runtime"]
EXPOSE 21114
CMD ["./apimain"]
